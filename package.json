{
  "name": "@nkzw/core",
  "version": "1.3.1",
  "description": "Lightweight core JavaScript functions.",
  "type": "module",
  "scripts": {
    "build": "tsdown src/*.ts -d lib --target=node22 --dts && pnpm copy-files",
    "copy-files": "cp README.md lib && cp package.json lib && cp LICENSE lib",
    "format": "prettier \"**/*.{js,jsx,json,tsx,ts}\" --write",
    "lint": "eslint --cache .",
    "test": "tsc && pnpm lint && vitest run"
  },
  "author": {
    "name": "Christoph Nakazawa",
    "email": "christoph.pojer@gmail.com"
  },
  "homepage": "https://github.com/nkzw-tech/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/core"
  },
  "license": "MIT",
  "publishConfig": {
    "directory": "./lib"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@nkzw/eslint-config": "^3.2.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "prettier": "4.0.0-alpha.12",
    "tsdown": "^0.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
